{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metastable-void/mechanics-core/json-schema/mechanics-job.schema.json",
  "title": "MechanicsJob",
  "description": "Serde-compatible JSON shape for mechanics-core job payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["module_source", "arg", "config"],
  "properties": {
    "module_source": {
      "type": "string",
      "minLength": 1
    },
    "arg": true,
    "config": {
      "$ref": "./mechanics-config.schema.json"
    },
    "run_timeout": {
      "anyOf": [{ "$ref": "#/$defs/duration" }, { "type": "null" }]
    }
  },
  "$defs": {
    "duration": {
      "description": "Serde-compatible JSON shape for std::time::Duration. MechanicsJob rejects zero duration when this field is present.",
      "type": "object",
      "additionalProperties": false,
      "required": ["secs", "nanos"],
      "properties": {
        "secs": { "type": "integer", "minimum": 0 },
        "nanos": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "anyOf": [
        { "properties": { "secs": { "minimum": 1 } } },
        { "properties": { "nanos": { "minimum": 1 } } }
      ]
    }
  }
}
